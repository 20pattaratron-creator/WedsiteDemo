# ===== Firebase (required for cloud login/sync) =====
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ===== Customer demo mode =====
# true  = open the ERP without Firebase login; data stays in this browser
# false = use Firebase Authentication / Firestore
VITE_DEMO_MODE=false

# ===== Optional Google Drive evidence upload =====
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
VITE_DRIVE_FOLDER_KHONKAEN_QUOTES=
VITE_DRIVE_FOLDER_KHONKAEN_INVOICES=
VITE_DRIVE_FOLDER_KHONKAEN_RECEIPTS=
VITE_DRIVE_FOLDER_KHONKAEN_PRODUCTIONS=
VITE_DRIVE_FOLDER_KHONKAEN_EXPENSES=
