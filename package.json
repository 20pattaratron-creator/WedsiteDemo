{
  "name": "example-company-erp-local-demo",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:fast": "node scripts/run-tests.mjs --fast",
    "test:list": "node scripts/run-tests.mjs --list",
    "verify": "npm run audit:code && npm run audit:deep && npm run audit:specs && npm run audit:documents && npm run audit:financial && npm run audit:render-golden && npm run security:preflight && npm test && npm run build && npm run build:flat && npm run test:deployment && npm run test:deployment:flat",
    "postbuild": "node scripts/build-deployment-check.mjs",
    "test:deployment": "node --experimental-vm-modules --test tests/deployment.check.cjs",
    "build:flat": "node scripts/build-flat-pages.mjs",
    "test:deployment:flat": "node --experimental-vm-modules --test tests/deployment-flat.check.cjs",
    "test:council": "node --test tests/decision-council.test.cjs",
    "audit:code": "node scripts/audit-codebase.mjs",
    "test:codebase": "node --test tests/codebase-audit.test.cjs",
    "test:executive": "node --test tests/executive-charts.test.cjs",
    "security:preflight": "node scripts/security/agent-repo-audit.mjs .",
    "security:preflight:strict": "node scripts/security/agent-repo-audit.mjs . --fail-on-warn",
    "security:scan": "node scripts/security/agent-repo-audit.mjs",
    "security:baseline": "node scripts/security/create-security-baseline.mjs .",
    "security:verify-baseline": "node scripts/security/verify-security-baseline.mjs .",
    "test:security": "node --test tests/agent-security.test.cjs",
    "audit:all": "npm run audit:code && npm run audit:deep && npm run audit:specs && npm run audit:complexity && npm run audit:documents && npm run audit:financial && npm run audit:render-golden && npm run security:preflight",
    "test:product": "node --test tests/product-experience.test.cjs",
    "audit:deep": "node scripts/audit-deep.mjs",
    "audit:specs": "node scripts/audit-specs.mjs",
    "audit:complexity": "node scripts/audit-complexity.mjs",
    "test:governance": "node --test tests/spec-governance.test.cjs",
    "test:core": "node scripts/run-core-tests.mjs",
    "quality:gate": "npm run quality:core && npm test && npm run build && npm run test:deployment && npm run security:verify-baseline",
    "evidence:core": "node scripts/run-core-evidence.mjs",
    "quality:core": "npm run audit:code && npm run audit:deep && npm run audit:specs && npm run audit:complexity && npm run audit:documents && npm run audit:financial && npm run audit:render-golden && npm run security:preflight && npm run test:core",
    "evidence:full": "node scripts/run-full-evidence.mjs",
    "validate:trial": "node scripts/validate-customer-trial.mjs",
    "audit:documents": "node scripts/audit-document-controllers.mjs",
    "audit:financial": "node scripts/audit-financial-controls.mjs",
    "audit:render-golden": "node scripts/audit-document-render-golden.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "26.1.0",
    "vite": "8.1.5"
  },
  "erpRelease": "4.3.1"
}
