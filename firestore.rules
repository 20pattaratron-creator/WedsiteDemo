rules_version = '2';

// =====================================================================
// Firestore Security Rules — Comform Esan ERP
// วิธีติดตั้ง: Firebase Console > Firestore Database > Rules > วางไฟล์นี้ทั้งหมด > Publish
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userBranch() {
      return userDoc().data.branch;
    }

    function isAdmin() {
      return isSignedIn() && userBranch() == 'all';
    }

    function canAccessBranch(docBranch) {
      return isSignedIn() && (isAdmin() || userBranch() == docBranch);
    }

    function canCreateForBranch() {
      return isSignedIn()
        && request.resource.data.branch is string
        && (isAdmin() || userBranch() == request.resource.data.branch);
    }

    function canUpdateSameBranch() {
      return isSignedIn()
        && request.resource.data.branch == resource.data.branch
        && canAccessBranch(resource.data.branch);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /quotes/{docId} {
      allow read: if canAccessBranch(resource.data.branch);
      allow create: if canCreateForBranch();
      allow update: if canUpdateSameBranch();
      allow delete: if canAccessBranch(resource.data.branch);
    }

    match /invoices/{docId} {
      allow read: if canAccessBranch(resource.data.branch);
      allow create: if canCreateForBranch();
      allow update: if canUpdateSameBranch();
      allow delete: if canAccessBranch(resource.data.branch);
    }

    match /receipts/{docId} {
      allow read: if canAccessBranch(resource.data.branch);
      allow create: if canCreateForBranch();
      allow update: if canUpdateSameBranch();
      allow delete: if canAccessBranch(resource.data.branch);
    }

    match /productions/{docId} {
      allow read: if canAccessBranch(resource.data.branch);
      allow create: if canCreateForBranch();
      allow update: if canUpdateSameBranch();
      allow delete: if canAccessBranch(resource.data.branch);
    }

    match /expenses/{docId} {
      allow read: if canAccessBranch(resource.data.branch);
      allow create: if canCreateForBranch();
      allow update: if canUpdateSameBranch();
      allow delete: if canAccessBranch(resource.data.branch);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
